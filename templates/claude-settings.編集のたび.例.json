{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "npx tenukiban check --hook --no-write", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "npx tenukiban check --hook", "timeout": 180 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(npx tenukiban accept *)",
      "Bash(tenukiban accept *)",
      "PowerShell(npx tenukiban accept *)",
      "PowerShell(tenukiban accept *)",
      "Edit(/.tenukiban/**)",
      "Edit(/tenukiban.config.json)"
    ]
  }
}
